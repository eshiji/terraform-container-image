{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Patch, digest and pin updates merge themselves once CI builds and tests the image",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Tool versions and base images ship in the image, so their updates are fixes and produce a release (release-please ignores chore)",
      "matchManagers": [
        "custom.regex",
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "semanticCommitType": "fix"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in Dockerfile ARGs annotated with a renovate comment",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\w+_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
